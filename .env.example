# 브라우저 노출 (anon)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것 — 후속 Phase에서 사용)
SUPABASE_SERVICE_ROLE_KEY=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
# 문자 실발송 스위치(true 일 때만 발송, 기본 꺼짐) / 테스트 기간 허용 수신번호(쉼표 구분, 선택)
SMS_ENABLED=
SMS_TEST_ALLOWLIST=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 입금기한 자동취소(cron) — CRON_SECRET 필수(Vercel 이 Bearer 로 첨부), AUTO_CANCEL_ENABLED=true 일 때만 실제 취소(그 외 점검 모드)
CRON_SECRET=
AUTO_CANCEL_ENABLED=
# 차수 1주일 전 안내 문자(cron, 매일 10:00 KST) — EVENT_REMINDER_ENABLED=true 일 때만 실제 발송 처리(그 외 점검 모드)
EVENT_REMINDER_ENABLED=
